rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && isValidProfileUpdate(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/readings/{readingId} {
      allow read: if request.auth != null && (request.auth.uid == userId || resource.data.isPublic == true);
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && isValidReading(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && isValidReading(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/cardAnnotations/{cardName} {
      allow read: if request.auth != null && (request.auth.uid == userId || canReadPublicAnnotation(resource.data));
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/numerologySettings/{cardName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /publicReadings/{readingId} {
      allow read: if true;
      allow create: if request.auth != null
        && ownsPrivateReading(readingId)
        && isValidPublicReading(request.resource.data);
      allow update: if request.auth != null
        && ownsPrivateReading(readingId)
        && isValidPublicReading(request.resource.data);
      allow delete: if request.auth != null
        && ownsPrivateReading(readingId);
    }
  }
}

function isValidProfileUpdate(data) {
  return !data.diff(resource.data).affectedKeys().hasAny(['id', 'createdAt'])
    && (!data.keys().hasAny(['user_public_id']) || data.user_public_id.matches('^TAROT-[A-Z0-9]{8}$'));
}

function isValidReading(data) {
  return data.hasAll(['question', 'cards', 'date']) &&
         data.cards is list &&
         data.cards.size() > 0;
}

function canReadPublicAnnotation(data) {
  return data.isPublic == true;
}

function isValidPublicReading(data) {
  return data.hasAll(['question', 'cards', 'date', 'isPublic']) &&
         data.keys().hasOnly([
           'id',
           'date',
           'question',
           'spread',
           'cards',
           'cardInterpretations',
           'interpretation',
           'keywords',
           'isPublic',
           'isAnonymous',
           'authorName',
           'layoutType',
           'slotLabels',
           'slotPositions',
           'rotatedSlots',
           'readingDate',
           'category',
           'isAiProcessed',
           'processedByAi',
           'showSlotNumbers',
           'updatedAt'
         ]) &&
         data.isPublic == true &&
         data.cards is list &&
         data.cards.size() > 0;
}

function ownsPrivateReading(readingId) {
  return exists(/databases/$(database)/documents/users/$(request.auth.uid)/readings/$(readingId));
}
